# "production" blendet alle Vorschau-Hinweise aus und erlaubt die Indexierung.
# Erst setzen, wenn Inhalte, Impressum und Datenschutz freigegeben sind.
NEXT_PUBLIC_SITE_MODE=preview

# Formularversand über Resend (kein Supabase, keine Datenbank – Anfragen werden nur per E-Mail zugestellt).
# 1. Domain bei Resend verifizieren (DNS-Einträge SPF/DKIM bei IONOS ergänzen, bestehende MX-Einträge nicht ändern).
# 2. API-Key mit "Sending access" nur für diese Domain anlegen.
# 3. Werte in Vercel (Production + Preview) eintragen – niemals committen.
RESEND_API_KEY=
# Absender auf der verifizierten Domain, z. B. "Zolarbyte Website <website@zolarbyte.de>"
CONTACT_FROM=
# Empfängerpostfach (vor Livegang bestätigen lassen); mehrere Adressen mit Komma trennen
CONTACT_RECIPIENT=
